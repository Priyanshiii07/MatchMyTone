# Copy to web/.env.local for local development. Contains no secrets: the website never needs an AI, email or database key.
# Server-side only: where the Next.js server reaches the Flask API (must end in /api).
MATCHMYTONE_API_BASE_URL=http://127.0.0.1:5000/api
# Older name, still read as a fallback by lib/auth.js on the server. Never put secrets in NEXT_PUBLIC_* variables:
# they can be bundled into browser code.
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:5000/api
