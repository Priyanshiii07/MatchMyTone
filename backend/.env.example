# Copy to backend/.env and fill in real values. Never commit backend/.env.
# production enables the startup safety checks (Render also sets RENDER=true, which does the same).
APP_ENV=development
# Local: mongodb://127.0.0.1:27017/matchmytone   Production: your MongoDB Atlas mongodb+srv:// connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/matchmytone
MONGODB_DB=matchmytone
# Two different random values of 32+ characters, e.g. python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-a-different-long-random-secret
# Access token lifetime; the web app stores it in an httpOnly cookie.
JWT_ACCESS_TOKEN_MINUTES=60
# On by default and mandatory in production (the API refuses to start with false there).
# Local development only may set false to skip verification.
REQUIRE_EMAIL_VERIFICATION=true
EMAIL_VERIFICATION_HOURS=24
FLASK_DEBUG=false
BACKEND_URL=http://127.0.0.1:5000
# The website's public URL (your Vercel URL in production): used in verification and password-reset links,
# and as the production CORS origin. BACKEND_URL is this API's own public URL.
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Leave empty to disable email; verification and password reset then report that email is not configured.
# FROM_EMAIL must use a domain verified in your Resend account.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend (check with: python scripts/check_email.py).
FROM_EMAIL=MatchMyTone <noreply@mail.yourdomain.com>

# Color analysis providers. Gemini models are tried in order, then OpenAI.
# Use only model ids returned by the provider's model-list endpoint.
GEMINI_API_KEY=replace-with-your-server-side-gemini-key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.1-flash-lite
GEMINI_API_VERSION=v1beta
GEMINI_THINKING_LEVEL=low
GEMINI_TIMEOUT_SECONDS=40
# Text-only stylist features (chat, looks, notes). Lite models have their own free daily quota.
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash
# If every model above is retired or unavailable, also try up to two stable Flash models the key can see.
GEMINI_AUTO_DISCOVER=true
# Hours a generated AI answer is reused for the same saved result and question.
AI_CACHE_HOURS=6
# Optional fallback; requires an OpenAI account with available credit.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=30
# Total time budget for one analysis across all providers.
COLOR_ANALYSIS_MAX_SECONDS=90
